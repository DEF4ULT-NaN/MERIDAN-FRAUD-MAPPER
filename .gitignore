# =====================================================================
# .gitignore for the Fraud Network Mapper
# Keep it small + readable. Group by language/tool so future you knows
# what each rule is for.
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
# Virtualenvs (created with `python -m venv .venv`)
.venv/
venv/
env/
ENV/
.python-version

# Bytecode / cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / build
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter notebooks (we don't ship any, but be safe)
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---------------------------------------------------------------------
# Node / npm (frontend)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
frontend/package-lock.json   # we don't lock to a specific http-server version
frontend/.npm/

# ---------------------------------------------------------------------
# Generated / large data artefacts
# ---------------------------------------------------------------------
# These are regenerated by scripts/build_graph.py and scripts/train_gnn.py.
# Don't push them to GitHub — they bloat the repo and break diffs.
data/graph.json
data/graph_gnn_scores.json
data/fraud_report_test.pdf

# Local test PDF outputs
*.pdf
!docs/**/*.pdf          # but DO keep any PDFs in docs/ (manuals, slides)

# PyTorch / NumPy large serialised blobs
*.pt.bak
*.pkl.bak

# ---------------------------------------------------------------------
# IDE / editor state
# ---------------------------------------------------------------------
.vscode/
!.vscode/settings.json   # keep team-shared settings if any
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# Secrets / local config
# ---------------------------------------------------------------------
.env
.env.*
!.env.example          # keep the template, ignore real envs
secrets.*
*.pem
*.key

# ---------------------------------------------------------------------
# Claude / agent session state (this project's local-only metadata)
# ---------------------------------------------------------------------
.claude/
# Note: the `.claude/` directory may contain shared team rules in some
# projects. If your team shares project-level Claude rules, swap this for:
# .claude/settings.local.json
# .claude/projects/

# ---------------------------------------------------------------------
# Runtime / log / temp files
# ---------------------------------------------------------------------
*.log
*.pid
*.seed
*.pid.lock
*.tmp
*.bak
*.swp
.cache/
.tmp/
tmp/
temp/

# Coverage / build reports
coverage/
*.lcov
.coverage
.nyc_output

# ---------------------------------------------------------------------
# Project-specific: keep what's needed for the Docker build
# ---------------------------------------------------------------------
# The Dockerfile COPYs models/ and data/samples/ into the image, so
# those MUST be tracked. Uncomment the next two lines only if you want
# to LFS-track the model file separately:
#   models/*.pt  filter=lfs diff=lfs merge=lfs -text
# For an 18 KB model this is unnecessary — GitHub handles it fine.

# === end of .gitignore ===